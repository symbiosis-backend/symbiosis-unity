  - Id: battle_tile_31
    DisplayName: Emerald Serpent Shield
    Prefab: {fileID: 1162972782420524311, guid: 42a17dd7325c406087255053b75698f1, type: 3}
    Rarity: 2
    IsDonate: 1
    IsFree: 1
